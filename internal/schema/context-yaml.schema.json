{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextfile.org/schema/v1.json",
  "title": "CONTEXT.yaml v1",
  "description": "Machine-readable project context for LLMs and developer tools. This file is the canonical source of truth for the v1 schema; the TypeScript types in context-yaml.ts mirror it.",
  "type": "object",
  "required": ["ktext", "identity"],
  "additionalProperties": false,
  "properties": {
    "ktext": {
      "type": "string",
      "enum": ["1.0.0"],
      "description": "Schema identifier and version. Follows the OpenAPI convention of naming the format and versioning it in one field. Only \"1.0.0\" is currently accepted."
    },
    "identity": {
      "type": "object",
      "required": ["name", "url"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "type": {
          "type": "string",
          "enum": [
            "service",
            "library",
            "application",
            "component",
            "platform",
            "tool",
            "documentation",
            "ci",
            "other"
          ]
        },
        "purpose": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["active", "deprecated", "experimental", "archived"]
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["content"],
        "additionalProperties": false,
        "properties": {
          "content": { "type": "string" },
          "scope": { "type": "string" },
          "why": { "type": "string" }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "rationale"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "rationale": { "type": "string" },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$",
            "description": "ISO date — YYYY, YYYY-MM, or YYYY-MM-DD"
          },
          "status": {
            "type": "string",
            "enum": ["proposed", "accepted", "rejected", "superseded", "deprecated"]
          },
          "reference": { "type": "string" }
        }
      }
    },
    "conventions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule"],
        "additionalProperties": false,
        "properties": {
          "rule": { "type": "string" },
          "scope": { "type": "string" },
          "why": { "type": "string" },
          "reference": { "type": "string" }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["content", "severity"],
        "additionalProperties": false,
        "properties": {
          "content": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "mitigation": { "type": "string" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "url"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "why": { "type": "string" }
        }
      }
    },
    "working": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["command", "description"],
            "additionalProperties": false,
            "properties": {
              "command": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "structure": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "description"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "links": {
      "type": "object",
      "description": "Open map of name → URL. Every value must be a URI; any string key is permitted. The well-known keys below are documented for tooling but not required.",
      "properties": {
        "repository": { "type": "string", "format": "uri", "description": "Source code repository" },
        "issues": { "type": "string", "format": "uri", "description": "Issue tracker" },
        "ci": { "type": "string", "format": "uri", "description": "CI/CD pipeline" },
        "docs": { "type": "string", "format": "uri", "description": "Documentation site" },
        "runbook": { "type": "string", "format": "uri", "description": "Operational runbook" },
        "dashboard": { "type": "string", "format": "uri", "description": "Monitoring dashboard" }
      },
      "additionalProperties": { "type": "string", "format": "uri" }
    },
    "ownership": {
      "type": "object",
      "description": "Who owns and maintains this project. The anyOf clause requires at least one of team/maintainers — both are listed as optional in `properties` so they can appear independently, but an empty {} (or one with only `escalation`) is rejected.",
      "additionalProperties": false,
      "anyOf": [
        { "required": ["team"] },
        { "required": ["maintainers"] }
      ],
      "properties": {
        "team": { "type": "string" },
        "escalation": { "type": "string" },
        "maintainers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "role": { "type": "string" }
            }
          }
        }
      }
    },
    "x": {
      "type": "object",
      "description": "Extension escape hatch for tool-specific metadata. Never validated. Use reverse-DNS-style keys to avoid collisions.",
      "additionalProperties": true
    }
  }
}